{
  "name": "taskforge-kanban",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "dev:full": "concurrently --kill-others \"npm run dev:server\" \"cross-env VITE_BACKEND_ENABLED=true npm run dev -- --strictPort\"",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:full": "cross-env VITE_BACKEND_ENABLED=true npm run build && npm run build:server",
    "start:server": "node dist-server/server/index.js",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "test:api": "tsx --test server/test/*.test.ts",
    "test:e2e:full": "playwright test --config playwright.full.config.js",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/session": "^11.1.4",
    "@fastify/static": "^10.1.6",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@fastify/websocket": "^11.3.4",
    "@lucide/vue": "^1.20.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "typebox": "^1.3.37",
    "vite": "^8.0.16",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
