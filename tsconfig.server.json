{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "rootDir": ".",
    "outDir": "dist-server",
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "src/data/initialBoard.js"],
  "exclude": ["server/test"]
}
